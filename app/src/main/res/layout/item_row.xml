<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/thumb" android:layout_width="44dp" android:layout_height="58dp"
        android:layout_marginEnd="12dp" android:scaleType="centerCrop" android:visibility="gone"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#E8EEF8" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#6B7A93" android:textSize="11sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/adm" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/act" android:layout_width="48dp" android:layout_height="40dp"
        android:gravity="center" android:textColor="#00E0A4" android:textSize="16sp" android:textStyle="bold"/>
</LinearLayout>
