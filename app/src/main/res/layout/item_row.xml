<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <ImageView android:id="@+id/thumb" android:layout_width="40dp" android:layout_height="54dp"
        android:layout_marginEnd="12dp" android:scaleType="centerCrop" android:visibility="gone"/>
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="#E8EEF8" android:textSize="15sp" android:textStyle="bold"
        android:maxLines="2" android:ellipsize="end"/>
    <LinearLayout android:id="@+id/adm" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/act" android:layout_width="40dp" android:layout_height="40dp"
        android:gravity="center" android:textColor="#00E0A4" android:textSize="20sp"/>
</LinearLayout>
